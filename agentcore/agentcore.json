{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "MultiAgentProject",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "MultiAgentProject"
  },
  "runtimes": [
    {
      "name": "OrchestratorAgent",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/OrchestratorAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "A2A",
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-west-2.amazonaws.com/us-west-2_rP0WP4oPU/.well-known/openid-configuration",
          "allowedClients": [
            "2r0nohpcrjnhsi2pvc1ck1f7on"
          ]
        }
      }
    },
    {
      "name": "DiagnosticAgent",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/DiagnosticAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "A2A",
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-west-2.amazonaws.com/us-west-2_rP0WP4oPU/.well-known/openid-configuration",
          "allowedClients": [
            "2r0nohpcrjnhsi2pvc1ck1f7on"
          ]
        }
      }
    },
    {
      "name": "EvidenceGuard",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/EvidenceGuard/",
      "buildContextPath": "./",
      "dockerfile": "app/EvidenceGuard/Dockerfile",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "A2A",
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-west-2.amazonaws.com/us-west-2_rP0WP4oPU/.well-known/openid-configuration",
          "allowedClients": [
            "2r0nohpcrjnhsi2pvc1ck1f7on"
          ]
        }
      }
    }
  ],
  "memories": [
    {
      "name": "InvestigationMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SUMMARIZATION",
          "name": "InvestigationSummary",
          "namespaceTemplates": [
            "investigations/{actorId}/summaries/{sessionId}"
          ]
        },
        {
          "type": "EPISODIC",
          "name": "PastRcaEpisodes",
          "namespaceTemplates": [
            "investigations/{actorId}/episodes/{sessionId}/",
            "investigations/{actorId}/episodes/{sessionId}/reflections"
          ],
          "reflectionNamespaceTemplates": [
            "investigations/{actorId}/episodes/{sessionId}/reflections"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [
    {
      "authorizerType": "OAuthCredentialProvider",
      "name": "GoogleSheetsReadOAuth",
      "vendor": "CustomOauth2",
      "usage": "outbound",
      "discoveryUrl": "https://accounts.google.com/.well-known/openid-configuration",
      "scopes": [
        "https://www.googleapis.com/auth/spreadsheets.readonly"
      ]
    }
  ],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "DataGateway",
      "description": "The sole read-only path to the fixed RCA Sheets fixture.",
      "protocolType": "MCP",
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE",
      "targets": [
        {
          "name": "SheetsRead",
          "targetType": "openApiSchema",
          "schemaSource": {"inline": {"path": "docs/google-sheets-read.openapi.yaml"}},
          "outboundAuth": {
            "type": "OAUTH",
            "credentialName": "GoogleSheetsReadOAuth",
            "scopes": ["https://www.googleapis.com/auth/spreadsheets.readonly"]
          }
        },
        {
          "name": "MathOps",
          "targetType": "lambda",
          "compute": {
            "host": "Lambda",
            "implementation": {"language": "Python", "path": "gateway/math_ops.py", "handler": "handler"},
            "pythonVersion": "PYTHON_3_12"
          },
          "toolDefinitions": [
            {"name": "sum", "description": "Sum a numeric field from supplied rows.", "inputSchema": {"type": "object", "properties": {"rows": {"type": "array"}, "field": {"type": "string"}}, "required": ["rows", "field"]}},
            {"name": "average", "description": "Average a numeric field from supplied rows.", "inputSchema": {"type": "object", "properties": {"rows": {"type": "array"}, "field": {"type": "string"}}, "required": ["rows", "field"]}},
            {"name": "percent_change", "description": "Calculate percent change across supplied rows.", "inputSchema": {"type": "object", "properties": {"rows": {"type": "array"}, "field": {"type": "string"}}, "required": ["rows", "field"]}},
            {"name": "group_by_aggregate", "description": "Aggregate supplied rows by a field.", "inputSchema": {"type": "object", "properties": {"rows": {"type": "array"}, "field": {"type": "string"}, "group_field": {"type": "string"}}, "required": ["rows", "field", "group_field"]}},
            {"name": "median", "description": "Find the median of a numeric field from supplied rows.", "inputSchema": {"type": "object", "properties": {"rows": {"type": "array"}, "field": {"type": "string"}}, "required": ["rows", "field"]}},
            {"name": "stddev", "description": "Find standard deviation of a numeric field from supplied rows.", "inputSchema": {"type": "object", "properties": {"rows": {"type": "array"}, "field": {"type": "string"}}, "required": ["rows", "field"]}},
            {"name": "variance", "description": "Find variance of a numeric field from supplied rows.", "inputSchema": {"type": "object", "properties": {"rows": {"type": "array"}, "field": {"type": "string"}}, "required": ["rows", "field"]}},
            {"name": "correlation", "description": "Correlate two numeric fields from supplied rows.", "inputSchema": {"type": "object", "properties": {"rows": {"type": "array"}, "field": {"type": "string"}, "other_field": {"type": "string"}}, "required": ["rows", "field", "other_field"]}},
            {"name": "min_max", "description": "Find minimum and maximum from supplied rows.", "inputSchema": {"type": "object", "properties": {"rows": {"type": "array"}, "field": {"type": "string"}}, "required": ["rows", "field"]}},
            {"name": "top_n", "description": "Find the highest N values from supplied rows.", "inputSchema": {"type": "object", "properties": {"rows": {"type": "array"}, "field": {"type": "string"}, "n": {"type": "integer"}}, "required": ["rows", "field"]}}
          ]
        }
      ]
    },
    {
      "name": "EvidenceGateway",
      "description": "The sole AgentCore Gateway path to managed web-search evidence.",
      "protocolType": "MCP",
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE",
      "targets": [
        {
          "name": "WebSearch",
          "targetType": "connector",
          "connectorId": "web-search",
          "configurations": [
            {
              "name": "WebSearch",
              "parameterValues": {
                "domainFilter": {
                  "exclude": [
                    "spam.example",
                    "misinformation.example"
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
